{
  "info": {
    "_postman_id": "pragati-projects-backend-module",
    "name": "Pragati - Projects Backend Module",
    "description": "Complete API test collection for the Projects Backend Module. Covers Project Details, Milestone Submissions, Final Project Submission, and Feedback retrieval.\n\n**Base URL**: http://localhost:5000\n\n**Auth**: All student routes require a Bearer JWT token.\n\n**Setup**: Register/login as a student to get a token, then set the `token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token",   "value": "PASTE_STUDENT_JWT_HERE",  "type": "string" },
    { "key": "projectId",   "value": "1", "type": "string" },
    { "key": "milestoneId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "✅ Get Project Details - Success",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}"]
            }
          }
        },
        {
          "name": "❌ Get Project - Not Found (ID 99999)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","99999"]
            }
          }
        },
        {
          "name": "❌ Get Project - Unauthorized (No Token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}"]
            }
          }
        },
        {
          "name": "❌ Get Project - Invalid ID (non-integer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/abc",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","abc"]
            }
          }
        }
      ]
    },
    {
      "name": "Milestones",
      "item": [
        {
          "name": "✅ Get Milestones - Success",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones"]
            }
          }
        },
        {
          "name": "✅ Submit Milestone - Success",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones/{{milestoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones","{{milestoneId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"https://github.com/teststudent/ecommerce-capstone\",\n  \"deployedUrl\": \"https://ecommerce-capstone.vercel.app\"\n}"
            }
          }
        },
        {
          "name": "❌ Submit Milestone - Invalid GitHub URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones/{{milestoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones","{{milestoneId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"not-a-github-url\",\n  \"deployedUrl\": \"https://myapp.vercel.app\"\n}"
            }
          }
        },
        {
          "name": "❌ Submit Milestone - Invalid Deployed URL (HTTP not HTTPS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones/{{milestoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones","{{milestoneId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"https://github.com/teststudent/ecommerce-capstone\",\n  \"deployedUrl\": \"http://myapp.vercel.app\"\n}"
            }
          }
        },
        {
          "name": "❌ Submit Milestone - Missing GitHub URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones/{{milestoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones","{{milestoneId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deployedUrl\": \"https://myapp.vercel.app\"\n}"
            }
          }
        },
        {
          "name": "❌ Submit Milestone - Deadline Expired (Past Milestone ID)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones/{{milestoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones","{{milestoneId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"https://github.com/teststudent/ecommerce-capstone\",\n  \"deployedUrl\": \"https://ecommerce-capstone.vercel.app\"\n}"
            }
          }
        },
        {
          "name": "❌ Submit Milestone - Unauthorized (No Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/milestones/{{milestoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","milestones","{{milestoneId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"https://github.com/teststudent/ecommerce-capstone\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Final Submission",
      "item": [
        {
          "name": "✅ Submit Final Project - Success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","submit"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "githubUrl",   "value": "https://github.com/teststudent/ecommerce-capstone", "type": "text" },
                { "key": "deployedUrl", "value": "https://ecommerce-capstone.vercel.app",              "type": "text" },
                { "key": "report",      "type": "file", "src": "/path/to/your/report.pdf" }
              ]
            }
          }
        },
        {
          "name": "❌ Submit Final Project - Missing PDF",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","submit"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "githubUrl",   "value": "https://github.com/teststudent/ecommerce-capstone", "type": "text" },
                { "key": "deployedUrl", "value": "https://ecommerce-capstone.vercel.app",              "type": "text" }
              ]
            }
          }
        },
        {
          "name": "❌ Submit Final Project - Invalid PDF (Non-PDF file)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","submit"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "githubUrl", "value": "https://github.com/teststudent/ecommerce-capstone", "type": "text" },
                { "key": "report",    "type": "file", "src": "/path/to/an/image.png" }
              ]
            }
          }
        },
        {
          "name": "❌ Submit Final Project - Invalid GitHub URL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","submit"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "githubUrl", "value": "not-a-valid-url",         "type": "text" },
                { "key": "report",    "type": "file", "src": "/path/to/your/report.pdf" }
              ]
            }
          }
        },
        {
          "name": "❌ Submit Final Project - Unauthorized",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","submit"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "githubUrl", "value": "https://github.com/teststudent/ecommerce-capstone", "type": "text" },
                { "key": "report",    "type": "file", "src": "/path/to/your/report.pdf" }
              ]
            }
          }
        },
        {
          "name": "✅ Get Submission Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/submission",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","submission"]
            }
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "✅ Get Project Feedback - Success",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","feedback"]
            }
          }
        },
        {
          "name": "❌ Get Feedback - Project Not Found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/99999/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","99999","feedback"]
            }
          }
        },
        {
          "name": "❌ Get Feedback - Not Submitted Yet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/2/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","2","feedback"]
            }
          }
        },
        {
          "name": "❌ Get Feedback - Unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/projects/{{projectId}}/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["api","student","projects","{{projectId}}","feedback"]
            }
          }
        }
      ]
    }
  ]
}
