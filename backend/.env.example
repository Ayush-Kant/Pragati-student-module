PORT=5000
NODE_ENV=development
POSTGRESQL_URI=postgresql://username:password@localhost:5432/database_name
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
STUDENT_JWT_EXPIRES_IN=15m
STUDENT_REFRESH_TTL_DAYS=7
PUBLIC_API_URL=http://localhost:5000
FIREBASE_PROJECT_ID=pragatistudentmodule
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"pragatistudentmodule","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@pragatistudentmodule.iam.gserviceaccount.com","client_id":"..."}
# Or use GOOGLE_APPLICATION_CREDENTIALS with the path to a Firebase service-account JSON file.
RESEND_API_KEY=your_resend_api_key
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
DAILY_API_KEY=your_daily_api_key
DAILY_API_URL=https://api.daily.co/v1
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Optional S3-compatible object storage for certificate PDFs.
# When omitted, certificate PDFs use local development storage.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Certificate verification QR image provider.
CERTIFICATE_QR_PROVIDER_URL=https://api.qrserver.com/v1/create-qr-code/

# Background SM-13 consistency check (minimum 60 seconds).
CERTIFICATE_AUTO_CHECK_INTERVAL_MS=300000
