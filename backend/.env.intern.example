# Safe local-only configuration for Pragati intern development.
# Copy this file to backend/.env via: npm run setup:dev

PORT=5000
NODE_ENV=development

POSTGRESQL_URI=postgresql://postgres:postgres@localhost:5432/pragati_dev

# Local-only JWT secret. Never use this value in production.
JWT_SECRET=pragati-local-development-secret
JWT_EXPIRES_IN=7d
STUDENT_JWT_EXPIRES_IN=15m
STUDENT_REFRESH_TTL_DAYS=7

PUBLIC_API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379

# Firebase Emulator Suite.
FIREBASE_PROJECT_ID=pragati-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional external services are intentionally disabled/not configured for local setup.
RESEND_API_KEY=
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1
VAPID_SUBJECT=mailto:student@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
